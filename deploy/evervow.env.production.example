# EverVow production example. COPY VALUES INTO YOUR REAL SECRET ENVIRONMENT.
# Never commit the real production .env file.
EVERAFTER_PRODUCTION=True
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=evervow.example.com,www.evervow.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://evervow.example.com,https://www.evervow.example.com

# Reverse proxy / HTTPS
EVERAFTER_TRUST_PROXY=True
EVERAFTER_SSL_REDIRECT=True
EVERAFTER_HSTS_SECONDS=31536000
EVERAFTER_HSTS_INCLUDE_SUBDOMAINS=True
# Enable preload only after every subdomain is permanently HTTPS.
EVERAFTER_HSTS_PRELOAD=False

# Rate limits
EVERAFTER_RATE_LIMIT_ENABLED=True
EVERAFTER_LOGIN_LIMIT=12
EVERAFTER_PUBLIC_READ_LIMIT=240
EVERAFTER_PUBLIC_WRITE_LIMIT=60
EVERAFTER_AGENT_LIMIT=600

# PostgreSQL
DB_NAME=wedding_service
DB_USER=wedding_app
DB_PASSWORD=REPLACE_ME
DB_HOST=127.0.0.1
DB_PORT=5433
DB_CONN_MAX_AGE=60

# Microsoft Graph / OneDrive (only if OneDrive is used)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_DRIVE_ID=
GRAPH_ROOT_FOLDER=EverVow
